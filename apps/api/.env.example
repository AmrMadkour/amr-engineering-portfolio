# .NET API — Environment Variables
# Reference only. .NET does NOT read .env files.
# Local dev: use dotnet user-secrets  |  Production: set env vars on your host
# Setup instructions: see CLAUDE.md → "Gemini API key"

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5088

# CORS — comma-separated allowed frontend origins
AllowedOrigins=http://localhost:3000

# Content folder path (relative to the API project root)
ContentPath=../../content

# Logging level: Verbose | Debug | Information | Warning | Error | Fatal
Serilog__MinimumLevel=Debug

# Gemini AI — get a key at https://aistudio.google.com
# Store locally with: dotnet user-secrets set "Gemini:ApiKey" "YOUR_KEY_HERE"
Gemini__ApiKey=YOUR_GEMINI_API_KEY_HERE
Gemini__ModelId=gemini-flash-latest
