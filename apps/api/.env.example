# ============================================================
# .NET API — Environment Variables
# Copy this file to .env and fill in the values, OR set these
# as environment variables in your hosting platform.
# ============================================================

# ASP.NET Core environment: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Listening URL (local dev)
ASPNETCORE_URLS=http://localhost:5000

# CORS — comma-separated list of allowed frontend origins
AllowedOrigins=http://localhost:3000

# Path to the /content folder (relative to the API project root)
ContentPath=../../content

# Serilog minimum log level: Verbose | Debug | Information | Warning | Error | Fatal
Serilog__MinimumLevel=Debug
