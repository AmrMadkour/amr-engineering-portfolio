# ============================================================
# Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.
# ============================================================

# Base URL of the .NET API (no trailing slash)
# Local dev: http://localhost:5088
# Production (Render): set to your Render service URL, e.g. https://amr-portfolio-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5088

# Public site URL — used for SEO metadata, sitemap canonical URLs, and OG image
# Local dev: http://localhost:3000
# Production (Vercel): set to your Vercel URL, e.g. https://amr-portfolio.vercel.app
# or custom domain when available
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default locale (must match one of: en | ar | nl)
NEXT_PUBLIC_DEFAULT_LOCALE=en
