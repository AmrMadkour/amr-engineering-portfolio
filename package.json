{
  "name": "amr-engineering-portfolio",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm -w apps/web run dev",
    "build:web": "npm -w apps/web run build",
    "lint:web": "npm -w apps/web run lint",
    "typecheck:web": "npm -w apps/web run typecheck",
    "test:web": "npm -w apps/web run test",
    "test:web:watch": "npm -w apps/web run test:watch",
    "test:web:coverage": "npm -w apps/web run test:coverage",
    "quality:web": "npm -w apps/web run quality",
    "quality:web:dupes": "npm -w apps/web run quality:dupes",
    "test:api": "dotnet test apps/api --settings apps/api/coverage.runsettings --collect:\"XPlat Code Coverage\" --results-directory apps/api/coverage-results --verbosity minimal",
    "test:api:coverage": "npm run test:api && dotnet reportgenerator -reports:\"apps/api/coverage-results/**/coverage.cobertura.xml\" -targetdir:\"apps/api/coverage-results/html\" -reporttypes:\"Html;TextSummary\"",
    "quality:api:dupes": "jscpd --config apps/api/.jscpd.json",
    "quality:api": "dotnet build apps/api --verbosity minimal && dotnet format apps/api --verify-no-changes && npm run test:api && npm run quality:api:dupes",
    "quality:all": "npm run quality:web && npm run quality:api"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1"
  },
  "devDependencies": {
    "jscpd": "^5.0.5"
  }
}
